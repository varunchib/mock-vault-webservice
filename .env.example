# ════════════════════════════════════════════════════
#  MockVault — Production .env template
#
#  On the server:
#    cp .env.example .env
#    nano .env   ← fill in JWT_SECRET only, everything else is ready
#
#  NEVER commit .env to git.
# ════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────────────
DB_NAME=mockvault
DB_USER=postgres
DB_PASSWORD=darkangel@oracle

# ── Backend ──────────────────────────────────────────────────────
HTTP_ADDR=:8080

# NOTE: @ in the password must be %40 in the URL.
# "postgres" is the Docker service name, not localhost.
DATABASE_URL=postgres://postgres:darkangel%40oracle@postgres:5432/mockvault?sslmode=disable

# "redis" is the Docker service name, not localhost.
REDIS_ADDR=redis:6379

# Generate on the server with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32_output

GOOGLE_CLIENT_ID=835254671460-aoq7ft44tdbt8pt9nm83gidv5f85sqrs.apps.googleusercontent.com

# Allow all origins while domain is being set up.
# Once api.pyqvault.in is live, change to: https://pyqvault.in
ALLOWED_ORIGINS=*

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=true
# none required because frontend (Cloudflare Workers) and API are on different domains
COOKIE_SAME_SITE=none
